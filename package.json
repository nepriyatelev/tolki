{
  "name": "ratatosk",
  "version": "0.0.0",
  "private": true,
  "description": "P2P voice & screen sharing",
  "author": "nepriyatelev",
  "homepage": "https://github.com/nepriyatelev/ratatosk-releases",
  "main": "./out/main/index.js",
  "desktopName": "ratatosk.desktop",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "perf:load": "electron-vite build && vite build -c perf/vite.client.config.ts && playwright test -c perf/playwright.config.ts"
  },
  "dependencies": {
    "mediasoup": "3.27.1",
    "selfsigned": "5.5.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@achingbrain/nat-port-mapper": "4.0.5",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@playwright/test": "1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-store": "12.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lucide-solid": "1.57.0",
    "mediasoup-client": "3.24.3",
    "prettier": "^3.9.10",
    "solid-js": "^1.9.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
